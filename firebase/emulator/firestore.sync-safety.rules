rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Route restricted to the isolated sync acceptance emulator config.
    match /sync_safety_test/{documentId} {
      allow read: if true;
      allow create, update: if request.resource.data.get('protocolVersion', 0) == 2;
      allow delete: if true;
    }
  }
}
